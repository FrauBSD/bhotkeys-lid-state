#!/bin/sh
############################################################ LICENSE
#
# Copyright (c) 2026 Devin Teske <dteske@FreeBSD.org>
#
# SPDX-License-Identifier: BSD-2-Clause
#
############################################################ IDENT(1)
#
# $Title: Set the ACPI lid-switch policy $
# $Copyright: 2026 Devin Teske. All rights reserved. $
# $FrauBSD: bhotkeys-lid-state/bin/lid-policy 2026-10-18 04:57:06 -0700 Devin Teske $
#
############################################################ INFORMATION
#
# Talk to lid-switchd over its control socket. awake, s0ix, and
# toggle show the new state with bosd. A missing socket shows a red
# caption that lid-switchd is not running. An unwritable socket
# shows a red caption for that. status shows neither.
#
#   lid-policy awake|s0ix|s3|toggle|status|suspend-s0ix|suspend-s3
#
############################################################ ENVIRONMENT

SOCK="${lid_switchd_socket:-/var/run/lid-switchd.sock}"

############################################################ GLOBALS

pgm="${0##*/}" # Program basename

WARN_XREF=';\x20see\x20lid-switchd(8)'
WARN_PERM='lid-switchd\x20socket\x20is\x20not\x20writable'"$WARN_XREF"
WARN_SERV='lid-switchd\x20is\x20not\x20running'"$WARN_XREF"

WARN_COLOR="#cb1008" # FreeBSD Red

############################################################ FUNCTIONS

quietly() { "$@" > /dev/null 2>&1; }
have() { quietly command -v "$@"; }

usage()
{
	exec >&2
	echo "Usage: $pgm awake|s0ix|s3|toggle|status|suspend-s0ix|suspend-s3"
	exit 2
}

lid_glyph()
{
	local glyph="$1"

	have bosd || return 0
	bosd "$glyph" &
}

# Red caption when lid-switchd is not listening
service_missing()
{
	have bosd || return 0
	bosd -F "$WARN_COLOR" -t "$WARN_SERV" &
}

# Red caption when the socket exists but is not writable
socket_unwritable()
{
	have bosd || return 0
	bosd -F "$WARN_COLOR" -t "$WARN_PERM" &
}

############################################################ MAIN

set -e

CMD="$1"
[ "$CMD" ] || usage

case "$CMD" in
awake|s0ix|s3|toggle|status|suspend-s0ix|suspend-s3) : ok ;;
*) usage
esac

if [ ! -S "$SOCK" ]; then
	echo "$pgm: $SOCK not available (is lid-switchd running?)" >&2
	# status is a query; the hotkey and the other verbs get the caption
	[ "$CMD" = status ] || service_missing
	exit 1
fi
if [ ! -w "$SOCK" ]; then
	echo "$pgm: $SOCK not writable" >&2
	[ "$CMD" = status ] || socket_unwritable
	exit 1
fi

# One shot: send command, read reply line
reply=$( printf '%s\n' "$CMD" | nc -U -N -w 5 "$SOCK" 2> /dev/null ) ||
	reply=

reply=$( printf '%s' "$reply" | tr -d '\r' | sed -n '1p' )
if [ ! "$reply" ] || [ "$reply" = "error" ] ||
   [ "${reply#error:}" != "$reply" ]
then
	echo "$pgm: $CMD failed${reply:+ ($reply)}" >&2
	exit 1
fi

case "$CMD" in
awake)
	lid_glyph lid-awake
	;;
s0ix|s3)
	lid_glyph lid-s0ix
	;;
toggle)
	# Reply is the new lid_switch_state value
	# NONE is the awake glyph; either sleep type is the other glyph
	case "$reply" in
	NONE)
		lid_glyph lid-awake
		;;
	suspend_to_idle|s2idle|fw_suspend|s2mem)
		lid_glyph lid-s0ix
		;;
	esac
	;;
status)
	printf '%s\n' "$reply"
	;;
esac

exit 0

################################################################################
# END
################################################################################
